#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
downloads_dir="${HOME}/Downloads"
target_dir="${repo_root}/home/dot_config/raycast/exports"
target_file="${target_dir}/current.rayconfig"

latest=$(ls -t "${downloads_dir}"/*.rayconfig 2>/dev/null | head -n 1 || true)

if [ -z "${latest}" ]; then
  echo "No .rayconfig file found in ${downloads_dir}" >&2
  exit 1
fi

mkdir -p "${target_dir}"
cp "${latest}" "${target_file}"

echo "Saved ${latest} to ${target_file}"
